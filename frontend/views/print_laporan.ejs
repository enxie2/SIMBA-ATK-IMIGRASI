<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak Laporan ATK - Imigrasi Tasikmalaya</title>
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            font-size: 12pt;
            color: #000;
            background-color: #fff;
            margin: 0;
            padding: 2cm;
        }

        /* Kop Surat Official */
        .kop-surat {
            display: flex;
            align-items: center;
            border-bottom: 3px double #000;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        .kop-logo {
            width: 80px;
            height: 80px;
            margin-right: 20px;
            flex-shrink: 0;
        }

        .kop-logo img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .kop-text {
            text-align: center;
            flex-grow: 1;
            line-height: 1.2;
        }

        .kop-text h3 {
            font-size: 12pt;
            font-weight: normal;
            margin: 0;
        }

        .kop-text h4 {
            font-size: 13pt;
            font-weight: bold;
            margin: 0;
        }

        .kop-text h2 {
            font-size: 15pt;
            font-weight: bold;
            margin: 5px 0;
        }

        .kop-text p {
            font-size: 9pt;
            margin: 2px 0;
        }

        .report-title {
            text-align: center;
            margin-bottom: 25px;
        }

        .report-title h2 {
            font-size: 14pt;
            font-weight: bold;
            margin: 0 0 5px 0;
            text-decoration: underline;
        }

        .report-title p {
            font-size: 11pt;
            margin: 0;
        }

        /* Table Laporan */
        table.report-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 35px;
            font-size: 10pt;
        }

        table.report-table th,
        table.report-table td {
            border: 1px solid #000;
            padding: 8px;
            vertical-align: top;
        }

        table.report-table th {
            background-color: #f2f2f2;
            text-align: center;
            font-weight: bold;
        }

        table.report-table td.center {
            text-align: center;
        }

        table.report-table td.items-list {
            line-height: 1.4;
        }

        /* Signatures block */
        .signatures {
            display: flex;
            justify-content: space-between;
            margin-top: 50px;
            page-break-inside: avoid;
            gap: 15px;
        }

        .sig-block {
            text-align: center;
            flex: 1;
            min-width: 150px;
            line-height: 1.3;
            font-size: 10pt;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 140px;
            /* Fixed height to align all footers at the bottom */
        }

        .sig-header p,
        .sig-footer p {
            margin: 0;
        }

        .sig-date {
            margin-bottom: 5px;
            min-height: 1.2em;
        }

        .sig-name {
            font-weight: bold;
            text-decoration: underline;
        }

        .sig-nip {
            margin-top: 3px;
        }

        @media print {
            body {
                padding: 0;
            }

            @page {
                size: A4 portrait;
                margin: 1.5cm;
            }
        }
    </style>
</head>

<body>

    <!-- Kop Surat -->
    <div class="kop-surat">
        <div class="kop-logo">
            <img src="/images/logo-kanim.jpg" alt="Logo Imigrasi Tasikmalaya">
        </div>
        <div class="kop-text">
            <h3>KEMENTERIAN IMIGRASI DAN PEMASYARAKATAN</h3>
            <h4>KANTOR WILAYAH JAWA BARAT</h4>
            <h2>KANTOR IMIGRASI KELAS I NON TPI KOTA TASIKMALAYA</h2>
            <p>Jl. Letnan Harun No. 2, Sukamulya, Kec. Bungursari, Tasikmalaya, Jawa Barat 46151</p>
            <p>Telp: (0265) 342616 | Email: kanim_tasikmalaya@kemenkumham.go.id</p>
        </div>
    </div>

    <!-- Title -->
    <div class="report-title">
        <h2>LAPORAN PENGAJUAN ALAT TULIS KANTOR (ATK)</h2>
        <p>
            <% if (start_date && end_date) { %>
                Periode: <%= formatDate(start_date) %> s/d <%= formatDate(end_date) %>
                        <% } else if (start_date) { %>
                            Periode: Mulai <%= formatDate(start_date) %>
                                <% } else if (end_date) { %>
                                    Periode: Sampai <%= formatDate(end_date) %>
                                        <% } else { %>
                                            Periode: Semua Riwayat Pengajuan
                                            <% } %>
        </p>
        <% if (division || status) { %>
            <p style="font-size: 10pt; margin-top: 4px;">
                <% const filterParts=[]; if (division) filterParts.push('Seksi: ' + division);
                  if (status) filterParts.push(' Status: ' + statusLabels[status]);
                %>
                <%= filterParts.join(' | ') %>
            </p>
        <% } %>
    </div>

    <!-- Results Table -->
    <table class="report-table">
        <thead>
            <tr>
                <th style="width: 5%;">No</th>
                <th style="width: 12%;">Tanggal</th>
                <th style="width: 18%;">Nama Pengaju / Seksi</th>
                <th style="width: 25%;">Barang ATK</th>
                <th style="width: 8%;">Jumlah</th>
                <th style="width: 8%;">Satuan</th>
                <th style="width: 14%;">Tujuan / Keperluan</th>
                <th style="width: 10%;">Keterangan</th>
            </tr>
        </thead>
        <tbody>
            <% if (requests.length === 0) { %>
                <tr>
                    <td colspan="8" style="text-align: center; font-style: italic; padding: 20px;">
                        Tidak ada data pengajuan yang sesuai dengan kriteria filter laporan.
                    </td>
                </tr>
            <% } else { %>
                <% requests.forEach(function(req, idx) { %>
                    <% const itemCount = req.items.length; %>
                    <% if (itemCount === 0) { %>
                        <tr>
                            <td class="center"><%= idx + 1 %></td>
                            <td class="center"><%= formatDateTime(req.created_at) %></td>
                            <td>
                                <strong><%= req.requester_name %></strong><br>
                                <span style="font-size: 8.5pt; color: #444;"><%= req.division %></span>
                            </td>
                            <td>-</td>
                            <td class="center">-</td>
                            <td class="center">-</td>
                            <td><%= req.purpose %></td>
                            <td class="center" style="font-size: 9pt; font-weight: bold;">
                                <%= statusLabels[req.status] || req.status.toUpperCase() %>
                            </td>
                        </tr>
                    <% } else { %>
                        <% req.items.forEach(function(it, itemIdx) { %>
                            <tr>
                                <% if (itemIdx === 0) { %>
                                    <td class="center" rowspan="<%= itemCount %>"><%= idx + 1 %></td>
                                    <td class="center" rowspan="<%= itemCount %>"><%= formatDateTime(req.created_at) %></td>
                                    <td rowspan="<%= itemCount %>">
                                        <strong><%= req.requester_name %></strong><br>
                                        <span style="font-size: 8.5pt; color: #444;"><%= req.division %></span>
                                    </td>
                                <% } %>
                                
                                <td><%= it.name %></td>
                                <td class="center"><%= it.quantity %></td>
                                <td class="center"><%= it.unit %></td>
                                
                                <% if (itemIdx === 0) { %>
                                    <td rowspan="<%= itemCount %>"><%= req.purpose %></td>
                                    <td class="center" style="font-size: 9pt; font-weight: bold;" rowspan="<%= itemCount %>">
                                        <%= statusLabels[req.status] || req.status.toUpperCase() %>
                                    </td>
                                <% } %>
                            </tr>
                        <% }); %>
                    <% } %>
                <% }); %>
            <% } %>
        </tbody>
    </table>

    <!-- Tanda Tangan -->
    <div class="signatures">
        <div class="sig-block">
            <div class="sig-header">
                <p class="sig-date">&nbsp;</p>
                <p style="font-weight: bold;">Pemohon</p>
            </div>
            <div class="sig-footer">
                <p class="sig-name">....................................................</p>
                <p class="sig-nip">NIP. ...............................................</p>
            </div>
        </div>
        <div class="sig-block">
            <div class="sig-header">
                <p class="sig-date">&nbsp;</p>
                <p style="font-weight: bold;">Mengetahui,<br>Kasi/Kasubag/TU</p>
            </div>
            <div class="sig-footer">
                <p class="sig-name">....................................................</p>
                <p class="sig-nip">NIP. ...............................................</p>
            </div>
        </div>
        <div class="sig-block">
            <div class="sig-header">
                <p class="sig-date">&nbsp;</p>
                <p style="font-weight: bold;">Menyetujui,<br>Kasubag TU / Kaur Umum</p>
            </div>
            <div class="sig-footer">
                <p class="sig-name">....................................................</p>
                <p class="sig-nip">NIP. ...............................................</p>
            </div>
        </div>
        <div class="sig-block">
            <div class="sig-header">
                <p class="sig-date">Tasikmalaya, <%= printDate %></p>
                <p style="font-weight: bold;">Yang Memberikan,<br>Petugas Gudang</p>
            </div>
            <div class="sig-footer">
                <p class="sig-name">....................................................</p>
                <p class="sig-nip">NIP. ...............................................</p>
            </div>
        </div>
    </div>

    <!-- Auto Print Script -->
    <script>
        window.onload = function () {
            window.print();
        };
    </script>
</body>
</html>